{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": ["src/server.ts", "src/agent/**/*", "src/telegram/**/*", "src/scheduler/**/*", "src/lib/**/*", "src/types/**/*"],
  "exclude": ["node_modules", "src/app"]
}
