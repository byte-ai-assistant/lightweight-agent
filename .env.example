PORT=3000

# Optional explicit Anthropic API key.
# If your Claude SDK environment is already authenticated, you may not need this.
ANTHROPIC_API_KEY=

# Recommended for memory embeddings and Whisper transcription.
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Explicit agent identity for Gmail via gws
AGENT_EMAIL=
GWS_BINARY=/opt/homebrew/bin/gws
GWS_CREDENTIALS_FILE=

# Voice replies
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Exa web search
EXA_API_KEY=

# GitHub access (MCP server-github)
GITHUB_TOKEN=
